{
  // Configuración para desplegar la web como Cloudflare Worker con contenido estático.
  // Cloudflare ejecuta "npx wrangler deploy" y publica los archivos de este directorio.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-crm",
  "compatibility_date": "2026-10-06",
  // Pequeño programa que recibe el formulario de presupuesto (/api/presupuesto)
  "main": "_fuente/worker/index.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Las rutas /api/* las atiende el programa; todo lo demás, los archivos de la web
    "run_worker_first": ["/api/*"],
    // Sirve 404.html cuando una página no existe
    "not_found_handling": "404-page"
  },
  // Necesario para las vistas previas de ramas (Cloudflare ejecuta "npx wrangler preview"
  // en las ramas que no son main). Puede ir vacío.
  "previews": {}
}
